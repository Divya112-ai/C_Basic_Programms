#include<stdio.h>
#include<conio.h>
void main()
{
int i,j;
clrscr();
i=1;
while(i<=5)
{
	j=1;
	while(j<=5)
	{
		if((i==3||j==3)||(i==1&&(j==1||j==4||j==5))||(i==2&&j==1)||(i==4&&j==5))
		{
			printf("* ");
		}
		else
		{
			printf("  ");
		}
		j++;
	}
	printf("\n");
	i++;
}
getch();
}